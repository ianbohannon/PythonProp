print("-" * 70)

try:
    # Test with zero circulation (no thrust/torque)
    G_zero = np.zeros(Mp)
    CT_zero, CQ_zero, CP_zero, _, _, _, _, _, _, _, _, _, _, _, _, _ = \
        Forces(RC, DR, VAC, VTC, UASTAR, UTSTAR, UADUCT, CD, CoD, G_zero,
               Z, Js, VMIV, 0, Rhub_oR, Rhv, 0.0)
    
    print(f"  Zero circulation: CT={CT_zero:.6f}, CQ={CQ_zero:.6f}")
    
    # Test with very high advance coefficient
    Js_high = 2.0
    CT_high_J, CQ_high_J, CP_high_J, _, _, _, _, _, _, _, EFFYo_high_J, _, _, _, _, _ = \
        Forces(RC, DR, VAC, VTC, UASTAR, UTSTAR, UADUCT, CD, CoD, G,
               Z, Js_high, VMIV, 0, Rhub_oR, Rhv, 0.0)
    
    print(f"  High J (2.0): CT={CT_high_J:.6f}, EFFYo={EFFYo_high_J:.6f}")
    
    # Test with low advance coefficient
    Js_low = 0.3
    CT_low_J, CQ_low_J, CP_low_J, _, _, _, _, _, _, _, EFFYo_low_J, _, _, _, _, _ = \
        Forces(RC, DR, VAC, VTC, UASTAR, UTSTAR, UADUCT, CD, CoD, G,
               Z, Js_low, VMIV, 0, Rhub_oR, Rhv, 0.0)
    
    print(f"  Low J (0.3): CT={CT_low_J:.6f}, EFFYo={EFFYo_low_J:.6f}")
    
    # All should be finite
    assert np.isfinite(CT_zero) and np.isfinite(CQ_zero), "Should handle zero circulation"
    assert np.isfinite(EFFYo_high_J), "Should handle high J"
    assert np.isfinite(EFFYo_low_J), "Should handle low J"
    
    print("  ✓ OK - Edge cases handled")
    
except Exception as e:
