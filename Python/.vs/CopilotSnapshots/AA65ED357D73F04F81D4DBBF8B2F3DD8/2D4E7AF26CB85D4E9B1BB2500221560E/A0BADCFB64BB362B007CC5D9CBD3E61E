# ============================================================================
# TEST 4: Effect of hub flag (rotor-rotor case)
# ============================================================================
print("\n" + "=" * 70)
print("TEST 4: Hub Flag Effect (Rotor-Rotor)")
print("-" * 70)

try:
    M1 = 10
    RC1 = np.linspace(0.3, 1.0, M1)
    RV1 = np.linspace(0.25, 1.0, M1 + 1)
    TANBIC1 = 0.5 * np.ones(M1)
    Z1 = 4

    # ROTOR-ROTOR case: scalar XC2, array RC2
    XC2 = 0.5
    RC2 = np.linspace(0.35, 0.95, 8)

    Rhub_oR1 = 0.2
    Rduct_oR1 = 1.1

    # Without hub
    UAHIF_no_hub, _, _ = Horseshoe_intr_110830(
        XC2, RC2, RC1, TANBIC1, RV1, Z1, 0, Rhub_oR1, 0, Rduct_oR1
    )

    # With hub
    UAHIF_with_hub, _, _ = Horseshoe_intr_110830(
        XC2, RC2, RC1, TANBIC1, RV1, Z1, 1, Rhub_oR1, 0, Rduct_oR1
    )

    diff = np.max(np.abs(UAHIF_with_hub - UAHIF_no_hub))
    print(f"Max difference with/without hub: {diff:.6f}")

    # Hub should affect results in rotor-rotor case
    assert diff > 1e-10, "Hub flag should affect results in rotor-rotor case"

    print("  OK - Hub flag affects rotor-rotor results as expected")
    print("\nNote: For rotor-duct cases, hub/duct images are NOT used (per MATLAB spec)")

except Exception as e:
    print(f"  FAIL - {e}")

