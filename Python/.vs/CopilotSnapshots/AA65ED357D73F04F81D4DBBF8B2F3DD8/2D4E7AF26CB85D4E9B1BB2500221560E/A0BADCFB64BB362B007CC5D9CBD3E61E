import numpy as np
from Horseshoe_intr_110830 import Horseshoe_intr_110830, HoughUA, HoughUR, Heuman
from Horseshoe_intr_110830 import Legendre_2nd_kind_half_order, Legendre_2nd_kind_minus_half_order

print("=" * 70)
print("Horseshoe_intr_110830.py Test Suite")
print("=" * 70)

# ============================================================================
# TEST 1: Helper functions
# ============================================================================
print("\nTEST 1: Helper Functions")
print("-" * 70)

# Test Legendre functions
try:
    z = 1.5
    Q_half = Legendre_2nd_kind_half_order(z)
    Q_Mhalf = Legendre_2nd_kind_minus_half_order(z)
    
    print(f"Legendre Q_{{1/2}}({z}) = {Q_half:.6f}")
    print(f"Legendre Q_{{-1/2}}({z}) = {Q_Mhalf:.6f}")
    
    assert np.isfinite(Q_half), "Q_half is not finite"
    assert np.isfinite(Q_Mhalf), "Q_Mhalf is not finite"
    print("  OK - Legendre functions working")
    
except Exception as e:
    print(f"  FAIL - {e}")

# Test Heuman function
try:
    phi = 0.5
    k = 0.7
    H = Heuman(phi, k)
    
    print(f"\nHeuman Lambda({phi:.2f}, {k:.2f}) = {H:.6f}")
    assert np.isfinite(H), "Heuman function returned non-finite value"
    print("  OK - Heuman function working")
    
except Exception as e:
    print(f"  FAIL - {e}")

# Test HoughUA
try:
    xc = 0.1
    rc = 0.7
    tanbiv = 0.5
    rv = 0.6
    Z = 4
    
    UA = HoughUA(xc, rc, tanbiv, rv, Z)
    print(f"\nHoughUA({xc}, {rc}, {tanbiv}, {rv}, {Z}) = {UA:.6f}")
    assert np.isfinite(UA), "HoughUA returned non-finite value"
    print("  OK - HoughUA working")
    
except Exception as e:
    print(f"  FAIL - {e}")

# Test HoughUR
try:
    UR = HoughUR(xc, rc, tanbiv, rv, Z)
    print(f"HoughUR({xc}, {rc}, {tanbiv}, {rv}, {Z}) = {UR:.6f}")
    assert np.isfinite(UR), "HoughUR returned non-finite value"
    print("  OK - HoughUR working")
    
except Exception as e:
    print(f"  FAIL - {e}")

# ============================================================================
# TEST 2: Rotor-duct interaction
# ============================================================================
print("\n" + "=" * 70)
print("TEST 2: Rotor-Duct Interaction")
print("-" * 70)

try:
    # Propeller parameters
    M1 = 10
    RC1 = np.linspace(0.2, 1.0, M1)
    RV1 = np.linspace(0.15, 1.0, M1 + 1)
    TANBIC1 = 0.5 * np.ones(M1)
    Z1 = 4
    
    # Duct parameters
    XC2 = np.array([0.0, 0.1, 0.2, 0.3, 0.4])  # array of axial positions
    RC2 = 1.08  # scalar radius
    
    Hub_flag = 0
    Rhub_oR1 = 0.15
    Duct_flag = 0
    Rduct_oR1 = 1.08
    
    print(f"Propeller: M1={M1}, Z1={Z1}")
    print(f"Duct: {len(XC2)} axial positions, RC2={RC2}")
    
    UAHIF21, UTHIF21, URHIF21 = Horseshoe_intr_110830(
        XC2, RC2, RC1, TANBIC1, RV1, Z1,
        Hub_flag, Rhub_oR1, Duct_flag, Rduct_oR1
    )
    
    print(f"\nOutput shapes:")
    print(f"  UAHIF21: {UAHIF21.shape}")
    print(f"  UTHIF21: {UTHIF21.shape}")
    print(f"  URHIF21: {URHIF21.shape}")
    
    print(f"\nUAHIF21 range: [{np.min(UAHIF21):.6f}, {np.max(UAHIF21):.6f}]")
    print(f"UTHIF21 range: [{np.min(UTHIF21):.6f}, {np.max(UTHIF21):.6f}]")
    print(f"URHIF21 range: [{np.min(URHIF21):.6f}, {np.max(URHIF21):.6f}]")
    
    # Check shapes
    assert UAHIF21.shape == (len(XC2), M1), "UAHIF21 shape mismatch"
    assert UTHIF21.shape == (len(XC2), M1), "UTHIF21 shape mismatch"
    assert URHIF21.shape == (len(XC2), M1), "URHIF21 shape mismatch"
    
    # Check all finite
    assert np.all(np.isfinite(UAHIF21)), "UAHIF21 contains non-finite values"
    assert np.all(np.isfinite(UTHIF21)), "UTHIF21 contains non-finite values"
    assert np.all(np.isfinite(URHIF21)), "URHIF21 contains non-finite values"
    
    # For rotor-duct, UTHIF21 should be zero
    assert np.all(UTHIF21 == 0), "UTHIF21 should be zero for rotor-duct"
    
    print("\n  OK - Rotor-duct interaction PASS")
    
except Exception as e:
    print(f"\n  FAIL - {e}")
    import traceback
    traceback.print_exc()

