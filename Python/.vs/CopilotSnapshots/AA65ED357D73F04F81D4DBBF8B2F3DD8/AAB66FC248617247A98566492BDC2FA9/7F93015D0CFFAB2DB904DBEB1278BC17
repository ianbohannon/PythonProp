"""Compute duct influence functions on the propeller blade panels."""

import numpy as np


def Duct_Influence(Rduct_oR, Cduct_oR, Xduct_oR, RC):
    """Compute duct geometry and its axial influence on propeller control points.

    Ported from ``SourceCode/Duct_Influence.m``.

    Returns the duct vortex-ring positions, their relative strengths, and
    the axial velocity induced at the propeller control points per unit
    total duct circulation ``Gd``.

    Parameters
    ----------
    Rduct_oR : float
        Duct radius / propeller radius.
    Cduct_oR : float
        Duct chord / propeller radius.
    Xduct_oR : float
        Axial position of duct mid-chord / propeller radius (positive
        downstream).
    RC : array_like, shape (Mp,)
        Control-point radii (r/R).

    Returns
    -------
    XdRING : ndarray, shape (Nd,)
        Axial (x/R) positions of the duct vortex rings.
    GdRING : ndarray, shape (Nd,)
        Relative circulation of each duct ring (sums to 1).
    UADIF : ndarray, shape (Mp,)
        Axial velocity induced at each propeller control point per unit
        duct circulation ``Gd`` (stub — returns zeros).
    """
    RC = np.asarray(RC, dtype=float)

    # Distribute Nd = 12 duct vortex rings over the duct chord (uniform)
    Nd = 12
    XdRING = Xduct_oR + Cduct_oR * np.linspace(-0.5, 0.5, Nd)
    GdRING = np.ones(Nd) / Nd     # uniform distribution, sums to 1

    UADIF = np.zeros_like(RC)
    return XdRING, GdRING, UADIF
