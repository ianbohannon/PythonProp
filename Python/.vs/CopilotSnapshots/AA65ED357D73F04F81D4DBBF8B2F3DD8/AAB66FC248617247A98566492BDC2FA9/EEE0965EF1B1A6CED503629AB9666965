# ============================================== FUNCTION _Analyze_some(...)
def _Analyze_some(pt, LAMBDA_some, feather):
    """Analyze a subset of operating states.

    This is an internal helper function that performs Newton iteration
    for a sequence of tip-speed ratios.

    Parameters
    ----------
    pt : dict
        Propeller/turbine data structure.
    LAMBDA_some : array_like
        Subset of tip-speed ratios to analyze.
    feather : float
        Feathering angle [radians].

    Returns
    -------
    some : dict
        States at the requested operating points.
    """
    if len(LAMBDA_some) == 0:
        # Return empty structure
        Mp = len(pt['design']['RC'])
        some = {
            'G': np.zeros((0, Mp)),
            'UASTAR': np.zeros((0, Mp)),
            'UTSTAR': np.zeros((0, Mp)),
            'VSTAR': np.zeros((0, Mp)),
            'TANBC': np.zeros((0, Mp)),
            'TANBIC': np.zeros((0, Mp)),
            'ALPHA': np.zeros((0, Mp)),
            'CL': np.zeros((0, Mp)),
            'CD': np.zeros((0, Mp)),
            'converged': np.zeros(0, dtype=bool),
            'iteration': np.zeros(0, dtype=int),
            'KT': np.zeros(0),
            'KQ': np.zeros(0),
            'CT': np.zeros(0),
            'CQ': np.zeros(0),
            'CP': np.zeros(0),
            'EFFYo': np.zeros(0),
            'Ja': np.zeros(0),
            'EFFY': np.zeros(0),
            'VMWV': np.zeros(0),
        }
        # Add duct fields if present
        if pt['input'].get('Duct_flag', 0) == 1:
            Nd = len(pt['design'].get('Xduct_oR', [1]))
            some.update({
                'Gd': np.zeros(0),
                'UARINGq': np.zeros(0),
                'URRINGq': np.zeros(0),
                'VSRINGq': np.zeros(0),
                'BetaIDq': np.zeros(0),
                'CLd': np.zeros(0),
                'UARING': np.zeros((0, Nd)),
                'URRING': np.zeros((0, Nd)),
                'UADUCT': np.zeros((0, Mp)),
                'TAU': np.zeros(0),
                'CTD': np.zeros(0),
            })
        return some

    Crash_count = 0

    # ------------------------------------------------ Unpack pt data structure
    design = pt['design']
    input_dict = pt['input']

    # ------------------------------------------------------------------- Flags
    Propeller_flag = input_dict['Propeller_flag']
    Viscous_flag = input_dict['Viscous_flag']
    Hub_flag = input_dict.get('Hub_flag', 0)
    Duct_flag = input_dict.get('Duct_flag', 0)
    Plot_flag = input_dict.get('Plot_flag', 0)
    Wake_flag = input_dict.get('Wake_flag', 0)
    Chord_flag = input_dict.get('Chord_flag', 0)

    # '------ Performance inputs ------'
    Z = input_dict['Z']

    if Propeller_flag == 1:
        Js = input_dict['Js']
        L = np.pi / Js
    else:
        L = input_dict['L']
        Js = np.pi / L

    # '------ Computational inputs ------'
    ITER = input_dict.get('ITER', 50)
    Rhv = input_dict.get('Rhv', 0.5)

    # '------ Design geometry ------'
    RC = design['RC']
    RV = design['RV']
    DR = design['DR']
    Rhub_oR = design['Rhub_oR']

    # '------ Design state ------'
    G = design['G'].copy().flatten()
    VAC = design['VAC']
    VTC = design['VTC']
    UASTAR = design['UASTAR']
    UTSTAR = design['UTSTAR']
    VSTAR = design['VSTAR']
    TANBIC = design['TANBIC']
    VMIV = design['VMIV']

    # '------ 2D section performance ------'
    BetaIC = np.arctan(TANBIC)
    ALPHA = np.zeros_like(RC)

    CL = design['CL']
    CD = design['CD']
    CoD = design['CoD']
    t0oc = design['t0oc']

    Mp = len(RC)

    ALPHAstall = input_dict.get('ALPHAstall', np.deg2rad(8))
    if np.isscalar(ALPHAstall):
        ALPHAstall = ALPHAstall * np.ones_like(RC)

    # --------------------------------------------- dCLdALPHA
    if 'dCLdALPHA' in input_dict:
        dCLdALPHA = input_dict['dCLdALPHA']
        if np.isscalar(dCLdALPHA):
            dCLdALPHA = dCLdALPHA * np.ones_like(RC)
        elif len(dCLdALPHA) != len(RC) and 'XR' in input_dict:
            dCLdALPHA = pchip_interpolate(input_dict['XR'], dCLdALPHA, RC)
    else:
        # Compute Propeller Aspect Ratio (PAR)
        XXR = np.linspace(Rhub_oR, 1, 100)
        if Chord_flag == 0 and 'XR' in input_dict and 'XCoD' in input_dict:
            PAR = (1 - Rhub_oR)**2 / np.trapz(InterpolateChord(input_dict['XR'], input_dict['XCoD'], XXR), XXR)
        else:
            PAR = (1 - Rhub_oR)**2 / np.trapz(InterpolateChord(RC, CoD, XXR), XXR)

        dCLdALPHA = (2 * np.pi / (1 + 2 / PAR)) * np.ones_like(RC)

    # ---------------------------------------------------------------------
    # '------ Duct parameters ------'
    if Duct_flag == 1:
        Rduct_oR = design['Rduct_oR']
        Cduct_oR = design['Cduct_oR']
        Xduct_oR = design['Xduct_oR']
        Gd = design['Gd']

        XdRING = design['XdRING']
        VARING = design['VARING']
        UARING = design['UARING']
        URRING = design['URRING']
        GdRING = design['GdRING']

        DAHIF_times_TANBIC = design['DAHIFtT']
        DRHIF_times_TANBIC = design['DRHIFtT']

        UADIF = design['UADIF']
        UADUCT = design['UADUCT']

        CDd = input_dict.get('CDd', 0.008)
        dCLdALPHAd = 2 * np.pi

        DAHIFq_times_TANBIC = design['DAHIFq_times_TANBIC']
        DRHIFq_times_TANBIC = design['DRHIFq_times_TANBIC']

        DAHIFq = np.zeros((len(DAHIFq_times_TANBIC), Mp))
        DRHIFq = np.zeros((len(DRHIFq_times_TANBIC), Mp))
        for m in range(Mp):
            DAHIFq[:, m] = DAHIFq_times_TANBIC[:, m] / TANBIC[m]
            DRHIFq[:, m] = DRHIFq_times_TANBIC[:, m] / TANBIC[m]

        UARINGq = DAHIFq @ G
        URRINGq = DRHIFq @ G

        VSRINGq = np.sqrt((VARING + UARINGq)**2 + (URRINGq)**2)
        CLd = 4 * np.pi * Gd / (VSRINGq * Cduct_oR)
        BetaIDq = np.arctan(-URRINGq / (VARING + UARINGq))

        CLd0 = CLd
        BetaIDq0 = BetaIDq
    else:
        Rduct_oR = 1
        UADUCT = np.zeros_like(RC)
        CTD = 0

    # ---------------------------------------------- Record on-design variables
    LAMBDA0 = L
    CL0 = CL.copy()
    CD0 = CD.copy()
    BetaIC0 = BetaIC.copy()

    # ------------------------- Initialize vortex Horseshoe Influence Functions
    UAHIF, UTHIF = Horseshoe110628(Mp, Z, TANBIC, RC, RV, Hub_flag, Rhub_oR, Duct_flag, Rduct_oR)

    # ---------------------------- Initialize output data structure
    NL = len(LAMBDA_some)

    some = {}
    some['G'] = np.zeros((NL, Mp))
    some['UASTAR'] = np.zeros((NL, Mp))
    some['UTSTAR'] = np.zeros((NL, Mp))
    some['VSTAR'] = np.zeros((NL, Mp))
    some['TANBC'] = np.zeros((NL, Mp))
    some['TANBIC'] = np.zeros((NL, Mp))

    some['ALPHA'] = np.zeros((NL, Mp))
    some['CL'] = np.zeros((NL, Mp))
    some['CD'] = np.zeros((NL, Mp))

    if Duct_flag == 1:
        Nd = len(XdRING)
        some['Gd'] = np.zeros(NL)
        some['UARINGq'] = np.zeros(NL)
        some['URRINGq'] = np.zeros(NL)
        some['VSRINGq'] = np.zeros(NL)
        some['BetaIDq'] = np.zeros(NL)
        some['CLd'] = np.zeros(NL)
        some['UARING'] = np.zeros((NL, Nd))
        some['URRING'] = np.zeros((NL, Nd))
        some['UADUCT'] = np.zeros((NL, Mp))
        some['TAU'] = np.zeros(NL)
        some['CTD'] = np.zeros(NL)

    some['converged'] = np.zeros(NL, dtype=bool)
    some['iteration'] = np.zeros(NL, dtype=int)

    some['CT'] = np.zeros(NL)
    some['CQ'] = np.zeros(NL)
    some['CP'] = np.zeros(NL)
    some['KT'] = np.zeros(NL)
    some['KQ'] = np.zeros(NL)
    some['EFFY'] = np.zeros(NL)
    some['EFFYo'] = np.zeros(NL)
    some['Ja'] = np.zeros(NL)
    some['VMWV'] = np.zeros(NL)

    # ------------------------------------------------ Implement RepairSpline
    Bsmooth = RepairSplineMatrix(RC)

    # -------------- For each LAMBDA, find the system state, and compute forces
    for i in range(len(LAMBDA_some)):
        if Crash_count > 3:
            print(f'Crash limit of 3 reached...skipping state: L = {LAMBDA_some[i]}, Js = {np.pi/LAMBDA_some[i]}')
            continue

        converged = True

        L_current = LAMBDA_some[i]
        Js_current = np.pi / LAMBDA_some[i]

        TANBC = VAC / (L_current * RC + VTC)

        # Allow twice as many iterations for the first state analyzed
        if i == 0:
            ITER_current = 2 * ITER
        elif i == 1:
            ITER_current = ITER
        else:
            ITER_current = ITER

        # =====================================================================
        # ==   FIND STATE OF SYSTEM USING NEWTON SOLVER
        N_iter = 1
        ERROR = 1
        ERRORtol = 0.005
        relax = 0.9

        # -------------- Initialize linear system of equations matrices
        R = np.zeros(4 * Mp)
        J = np.eye(4 * Mp)
        DX = np.zeros(4 * Mp)

        while N_iter <= ITER_current and np.any(np.abs(ERROR) > ERRORtol):
            # ---------------------------------- Store last state
            VSTARlast = VSTAR.copy()
            alphalast = ALPHA.copy()
            CLlast = CL.copy()
            Glast = G.copy()

            # ------------- Solve Newton problem
            for m in range(Mp):
                # ------------------------------------------------------ Evaluate residuals
                R[m] = VSTAR[m] - np.sqrt((VAC[m] + UADUCT[m] + UASTAR[m])**2 + 
                                         (L_current * RC[m] + VTC[m] + UTSTAR[m])**2)

                R[Mp + m] = ALPHA[m] - (BetaIC0[m] - np.arctan(TANBIC[m]) + feather)

                R[2*Mp + m] = CL[m] - _CLCD_vs_ALPHA_scalar(ALPHA[m], ALPHAstall[m], 
                                                            CL0[m], CD0[m], dCLdALPHA[m], 
                                                            Propeller_flag)

                R[3*Mp + m] = G[m] - (1 / (2 * np.pi)) * VSTAR[m] * CL[m] * CoD[m]

                # --------------------------------------- Evaluate residual derivatives
                for n in range(Mp):
                    denom = np.sqrt((VAC[m] + UADUCT[m] + UASTAR[m])**2 + 
                                   (L_current * RC[m] + VTC[m] + UTSTAR[m])**2)
                    J[m, 3*Mp + n] = (-(VAC[m] + UADUCT[m] + UASTAR[m]) / denom) * UAHIF[m, n] + \
                                    (-(L_current * RC[m] + VTC[m] + UTSTAR[m]) / denom) * UTHIF[m, n]

                    temp = 1 / (1 + TANBIC[m]**2)
                    J[Mp + m, 3*Mp + n] = (temp / (L_current * RC[m] + VTC[m] + UTSTAR[m])) * UAHIF[m, n] + \
                                         (-temp * TANBIC[m] / (L_current * RC[m] + VTC[m] + UTSTAR[m])) * UTHIF[m, n]

                J[2*Mp + m, Mp + m] = -_Find_dCLCDdALPHA(ALPHA[m], ALPHAstall[m], 
                                                         CL0[m], CD0[m], dCLdALPHA[m], 
                                                         Propeller_flag)

                J[3*Mp + m, m] = -(1 / (2 * np.pi)) * CL[m] * CoD[m]
                J[3*Mp + m, 2*Mp + m] = -(1 / (2 * np.pi)) * VSTAR[m] * CoD[m]

            # ------------------------- Update Newton solver
            DX = np.linalg.solve(J, -R)

            if np.any(np.isnan(DX)) or not np.all(np.isreal(DX)) or np.any(np.abs(DX) > 1e4):
                DX = np.zeros(4 * Mp)
                print('<WARNING>')
                print('<WARNING> DX == NaN or imaginary... crash avoided...')
                print('<WARNING>')
                N_iter = 999
                converged = False
                Crash_count += 1

            VSTAR = VSTAR + relax * DX[0:Mp]
            ALPHA = ALPHA + relax * DX[Mp:2*Mp]
            CL = CL + relax * DX[2*Mp:3*Mp]
            G = G + relax * DX[3*Mp:4*Mp]

            # ----------------- Update unknowns not in Newton solver
            UASTAR = UAHIF @ G
            UTSTAR = UTHIF @ G

            TANBIC = (VAC + UADUCT + UASTAR) / (L_current * RC + VTC + UTSTAR)

            # Smooth the inflow angle
            TANBICsmooth = Bsmooth @ TANBIC

            UAHIF, UTHIF = Horseshoe110628(Mp, Z, TANBICsmooth, RC, RV, 
                                          Hub_flag, Rhub_oR, Duct_flag, Rduct_oR)

            # ------------------------------------------ Update duct parameters
            if Duct_flag == 1:
                for m in range(Mp):
                    DAHIFq[:, m] = DAHIFq_times_TANBIC[:, m] / TANBICsmooth[m]
                    DRHIFq[:, m] = DRHIFq_times_TANBIC[:, m] / TANBICsmooth[m]

                UARINGq = DAHIFq @ G
                URRINGq = DRHIFq @ G

                VSRINGq = np.sqrt((VARING + UARINGq)**2 + (URRINGq)**2)
                BetaIDq = np.arctan(-URRINGq / (VARING + UARINGq))
                CLd = dCLdALPHAd * (BetaIDq0 - BetaIDq) + CLd0
                Gd = CLd * VSRINGq * Cduct_oR / (4 * np.pi)

                UADUCT = UADIF * Gd

            # ------------------------------------------ Evaluate normalized residuals
            CLtemp = np.array([_CLCD_vs_ALPHA_scalar(ALPHA[m], ALPHAstall[m], 
                                                     CL0[m], CD0[m], dCLdALPHA[m], 
                                                     Propeller_flag) 
                              for m in range(Mp)])

            ERROR = np.concatenate([
                (VSTAR - np.sqrt((VAC + UADUCT + UASTAR)**2 + (L_current * RC + VTC + UTSTAR)**2)) / 
                    np.maximum(np.abs(VSTAR), 1e-4),
                (ALPHA - (BetaIC0 - np.arctan(TANBIC) + feather)) / 
                    np.maximum(np.abs(ALPHA), 1e-2),
                (CL - CLtemp) / np.maximum(np.abs(CL), 1e-4),
                (G - (1 / (2 * np.pi)) * VSTAR * CL * CoD) / np.maximum(np.abs(G), 1e-6)
            ])

            N_iter += 1

        if N_iter > ITER_current and converged:
            print('WARNING: Newton solver did NOT converge.')
            print(' ')
            converged = False
            Crash_count += 1

        N_iter = N_iter - 1

        # ------------------------------------------------------ Compute forces
        if Duct_flag == 1:
            DAHIF = np.zeros_like(DAHIF_times_TANBIC)
            DRHIF = np.zeros_like(DRHIF_times_TANBIC)
            for m in range(Mp):
                DAHIF[:, m] = DAHIF_times_TANBIC[:, m] / TANBICsmooth[m]
                DRHIF[:, m] = DRHIF_times_TANBIC[:, m] / TANBICsmooth[m]

            UARING = DAHIF @ G
            URRING = DRHIF @ G

            # CTD calculation would require Duct_Thrust function
            # For now, use the design value
            CTD = design.get('CTD', 0)

        CL_final = np.array([_CLCD_vs_ALPHA_scalar(ALPHA[m], ALPHAstall[m], 
                                                   CL0[m], CD0[m], dCLdALPHA[m], 
                                                   Propeller_flag) 
                            for m in range(Mp)])
        CD_final = np.array([_CLCD_vs_ALPHA_scalar(ALPHA[m], ALPHAstall[m], 
                                                   CL0[m], CD0[m], dCLdALPHA[m], 
                                                   Propeller_flag, return_CD=True) 
                            for m in range(Mp)])

        if Viscous_flag == 0:
            CD_final = np.zeros_like(CD_final)

        CT, CQ, CP, KT, KQ, CTH, TAU, Ja, Jw, VMWV, EFFYo, EFFY, ADEFFY, QF = Forces(
            RC, DR, VAC, VTC, UASTAR, UTSTAR, UADUCT, CD_final, CoD, G, Z, 
            Js_current, VMIV, Hub_flag, Rhub_oR, Rhv, CTD
        )

        # Check for crashes
        if (Propeller_flag == 1) and (KT < 0 or KQ < 0):
            Crash_count += 1
        elif (Propeller_flag == 0) and (CP > 0):
            Crash_count += 1

        # ------------------------- Record output data
        some['converged'][i] = converged
        some['iteration'][i] = N_iter

        some['G'][i, :] = G
        some['UASTAR'][i, :] = UASTAR
        some['UTSTAR'][i, :] = UTSTAR
        some['VSTAR'][i, :] = VSTAR
        some['TANBC'][i, :] = TANBC
        some['TANBIC'][i, :] = TANBIC

        some['ALPHA'][i, :] = ALPHA
        some['CL'][i, :] = CL_final
        some['CD'][i, :] = CD_final

        if Duct_flag == 1:
            some['Gd'][i] = Gd
            some['UARINGq'][i] = UARINGq
            some['URRINGq'][i] = URRINGq
            some['VSRINGq'][i] = VSRINGq
            some['BetaIDq'][i] = BetaIDq
            some['CLd'][i] = CLd
            some['UARING'][i, :] = UARING
            some['URRING'][i, :] = URRING
            some['UADUCT'][i, :] = UADUCT
            some['TAU'][i] = TAU
            some['CTD'][i] = CTD

        some['KT'][i] = KT
        some['KQ'][i] = KQ
        some['CT'][i] = CT
        some['CQ'][i] = CQ
        some['CP'][i] = CP
        some['EFFY'][i] = EFFY
        some['EFFYo'][i] = EFFYo
        some['Ja'][i] = Ja
        some['VMWV'][i] = VMWV

        # -------------------------------------------------------------------------
        print(' ')
        print(f'Forces for state: L = {L_current}, Js = {Js_current}')
        print(' ')
        if Propeller_flag == 1:
            print(f'    Js = {Js_current}')
            print(f'    KT = {KT}')
            print(f'    KQ = {KQ}')
            print(f'    CT = {CT}')
            if abs(VMIV - 1) > 1e-8:
                print(f'    Ja = {Ja}')
            print(f'  EFFY = {EFFY}')
        else:
            print(f'CT = {CT}')
            print(f'CP = {CP}')
        print(' ')

        if N_iter < 10:
            print(f'The max error for iteration  {N_iter} is: {np.max(np.abs(ERROR))}')
        else:
            print(f'The max error for iteration {N_iter} is: {np.max(np.abs(ERROR))}')
        print(' ')
        print('------------------------------------------------')
        print(' ')

    return some


def _CLCD_vs_ALPHA_scalar(alpha, ALPHAstall, CL0, CD0, dCLdALPHA, Propeller_flag, return_CD=False):
    """Compute CL or CD at angle of attack (scalar version).

    Simple linear lift curve with stall limits.
    """
    if abs(alpha) < ALPHAstall:
        CL = CL0 + dCLdALPHA * alpha
        CD = CD0
    else:
        # Post-stall
        CL = CL0 + dCLdALPHA * np.sign(alpha) * ALPHAstall
        CD = CD0 * 2  # Simple stall model

    if return_CD:
        return CD
    else:
        return CL


def _Find_dCLCDdALPHA(alpha, ALPHAstall, CL0, CD0, dCLdALPHA, Propeller_flag):
    """Find derivative of CL with respect to alpha."""
    if abs(alpha) < ALPHAstall:
        return dCLdALPHA
    else:
        return 0.0  # Flat in stall region
