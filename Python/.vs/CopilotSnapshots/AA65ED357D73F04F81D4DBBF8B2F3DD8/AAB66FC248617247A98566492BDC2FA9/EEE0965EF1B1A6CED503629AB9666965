"""Analyze off-design operating states for a given propeller design.

This function computes the "states" of a given propeller/turbine "design"
at given off-design tip speed ratios.

Method:
    Newton solver with state variables: (VSTAR, ALPHA, CL, G), size [4*Mp, 1]
    with (UASTAR, UTSTAR, TANBIC,...) updated between iterations.

Ported from OpenProp v3.3.4 SourceCode/Analyze.m
"""

import numpy as np
from scipy.interpolate import pchip_interpolate

from Horseshoe110628 import Horseshoe110628
from Horseshoe_intr_110830 import Horseshoe_intr_110830
from Forces import Forces
from RepairSpline import RepairSplineMatrix
from InterpolateChord import InterpolateChord


def Analyze(pt, LAMBDAall, feather=0.0):
    """Compute performance across a range of advance coefficients.

    Parameters
    ----------
    pt : dict
        Propeller/turbine data structure (must include ``pt['input']`` and
        ``pt['design']``).
    LAMBDAall : array_like
        Tip-speed ratios (omega*R/Vs) at which to evaluate performance.
    feather : float, optional
        Feathering angle [deg], pitch angle displacement relative to design
        geometry (for controllable-pitch rotors). Default is 0.

    Returns
    -------
    states : dict
        Off-design states dictionary containing performance metrics at each
        operating point in LAMBDAall.
    """
    feather = np.deg2rad(feather)  # Convert to radians

    # Handle legacy field names
    if 'i' in pt and 'input' not in pt:
        pt['input'] = pt['i']
    if 'd' in pt and 'design' not in pt:
        pt['design'] = pt['d']

    design = pt['design']
    input_dict = pt['input']

    # ========================================================== Error checking
    Wake_flag = input_dict.get('Wake_flag', 0)
    if Wake_flag == 1:
        print('ERROR: Wake_Horseshoe(...) is no longer supported')
        return {}

    # -------------------------------------------------------------------------
    Duct_flag = input_dict.get('Duct_flag', 0)

    if Duct_flag == 1:
        Rduct_oR = design['Rduct_oR']
        Cduct_oR = design['Cduct_oR']
        Xduct_oR = design['Xduct_oR']
        RC = design['RC']
        RV = design['RV']
        Z = input_dict['Z']
        Hub_flag = input_dict['Hub_flag']
        Rhub_oR = design['Rhub_oR']

        print(' ')
        print('Computing rotor-duct interaction...be patient...')
        print(' ')

        DAHIFq_times_TANBIC, _, DRHIFq_times_TANBIC = Horseshoe_intr_110830(
            Xduct_oR - Cduct_oR / 4, Rduct_oR, RC, np.ones_like(RC), RV, 
            Z, Hub_flag, Rhub_oR, Duct_flag, Rduct_oR
        )

        pt['design']['DAHIFq_times_TANBIC'] = DAHIFq_times_TANBIC
        pt['design']['DRHIFq_times_TANBIC'] = DRHIFq_times_TANBIC

    # -------------------------- Initialize output data structure "states"
    LAMBDAall = np.sort(LAMBDAall)  # Sort into ascending order

    NL = len(LAMBDAall)
    Mp = len(pt['design']['RC'])

    states = {}
    states['part1'] = '------ Off-design states ------'
    states['L'] = LAMBDAall.copy()
    states['Js'] = np.pi / states['L']

    states['RC'] = pt['design']['RC'].copy()
    states['CoD'] = pt['design']['CoD'].copy()

    states['G'] = np.zeros((NL, Mp))
    states['UASTAR'] = np.zeros((NL, Mp))
    states['UTSTAR'] = np.zeros((NL, Mp))
    states['VSTAR'] = np.zeros((NL, Mp))
    states['TANBC'] = np.zeros((NL, Mp))
    states['TANBIC'] = np.zeros((NL, Mp))

    states['ALPHA'] = np.zeros((NL, Mp))
    states['CL'] = np.zeros((NL, Mp))
    states['CD'] = np.zeros((NL, Mp))

    states['part2'] = '------ Numerical metrics ------'
    states['converged'] = np.zeros(NL, dtype=bool)
    states['iteration'] = np.zeros(NL, dtype=int)

    if Duct_flag == 1:
        states['part3'] = '------ Duct parameters ------'
        Nd = len(design['Xduct_oR']) if hasattr(design['Xduct_oR'], '__len__') else 1
        states['Gd'] = np.zeros(NL)
        states['UARINGq'] = np.zeros(NL)
        states['URRINGq'] = np.zeros(NL)
        states['VSRINGq'] = np.zeros(NL)
        states['BetaIDq'] = np.zeros(NL)
        states['CLd'] = np.zeros(NL)
        states['UARING'] = np.zeros((NL, Nd))
        states['URRING'] = np.zeros((NL, Nd))
        states['UADUCT'] = np.zeros((NL, Mp))
        states['TAU'] = np.zeros(NL)
        states['CTD'] = np.zeros(NL)
        states['part4'] = '------ Performance metrics ------'
    else:
        states['part3'] = '------ Performance metrics ------'

    states['KT'] = np.zeros(NL)
    states['KQ'] = np.zeros(NL)
    states['CT'] = np.zeros(NL)
    states['CQ'] = np.zeros(NL)
    states['CP'] = np.zeros(NL)

    if abs(design['VMIV'] - 1) > 1e-8:
        states['EFFYo'] = np.zeros(NL)
        states['Ja'] = np.zeros(NL)

    states['EFFY'] = np.zeros(NL)
    states['VMWV'] = np.zeros(NL)

    # ---------------------- Analyze states from design point outward
    if 'L' in input_dict:
        LAMBDA0 = input_dict['L']
    else:
        LAMBDA0 = np.pi / input_dict['Js']

    # Find design lambda index
    idx_design = np.where(LAMBDAall <= LAMBDA0)[0]
    if len(idx_design) > 0:
        idx_design = idx_design[-1]
        LAMBDA_low = LAMBDAall[idx_design::-1]  # Descending from design
        LAMBDA_high = LAMBDAall[idx_design:]    # Ascending from design
    else:
        # All LAMBDA are greater than design
        LAMBDA_low = np.array([])
        LAMBDA_high = np.concatenate([[LAMBDAall[0]], LAMBDAall])

    # ------------------- Analyze lower LAMBDA states first, then higher
    s_low = _Analyze_some(pt, LAMBDA_low, feather)
    s_high = _Analyze_some(pt, LAMBDA_high, feather)

    # ------------------------------- Output results in increasing LAMBDA order
    def _combine(s_low_field, s_high_field):
        """Combine low and high results, reversing low and removing duplicate."""
        if s_low_field.ndim == 1:
            return np.concatenate([s_low_field[::-1], s_high_field[1:]])
        else:
            return np.vstack([s_low_field[::-1], s_high_field[1:]])

    states['G'] = _combine(s_low['G'], s_high['G'])
    states['UASTAR'] = _combine(s_low['UASTAR'], s_high['UASTAR'])
    states['UTSTAR'] = _combine(s_low['UTSTAR'], s_high['UTSTAR'])
    states['VSTAR'] = _combine(s_low['VSTAR'], s_high['VSTAR'])
    states['TANBC'] = _combine(s_low['TANBC'], s_high['TANBC'])
    states['TANBIC'] = _combine(s_low['TANBIC'], s_high['TANBIC'])

    states['ALPHA'] = _combine(s_low['ALPHA'], s_high['ALPHA'])
    states['CL'] = _combine(s_low['CL'], s_high['CL'])
    states['CD'] = _combine(s_low['CD'], s_high['CD'])

    if Duct_flag == 1:
        states['Gd'] = _combine(s_low['Gd'], s_high['Gd'])
        states['UARINGq'] = _combine(s_low['UARINGq'], s_high['UARINGq'])
        states['URRINGq'] = _combine(s_low['URRINGq'], s_high['URRINGq'])
        states['VSRINGq'] = _combine(s_low['VSRINGq'], s_high['VSRINGq'])
        states['BetaIDq'] = _combine(s_low['BetaIDq'], s_high['BetaIDq'])
        states['CLd'] = _combine(s_low['CLd'], s_high['CLd'])
        states['UARING'] = _combine(s_low['UARING'], s_high['UARING'])
        states['URRING'] = _combine(s_low['URRING'], s_high['URRING'])
        states['UADUCT'] = _combine(s_low['UADUCT'], s_high['UADUCT'])
        states['TAU'] = _combine(s_low['TAU'], s_high['TAU'])
        states['CTD'] = _combine(s_low['CTD'], s_high['CTD'])

    states['converged'] = _combine(s_low['converged'], s_high['converged'])
    states['iteration'] = _combine(s_low['iteration'], s_high['iteration'])

    states['KT'] = _combine(s_low['KT'], s_high['KT'])
    states['KQ'] = _combine(s_low['KQ'], s_high['KQ'])
    states['CT'] = _combine(s_low['CT'], s_high['CT'])
    states['CQ'] = _combine(s_low['CQ'], s_high['CQ'])
    states['CP'] = _combine(s_low['CP'], s_high['CP'])

    if abs(design['VMIV'] - 1) > 1e-8:
        states['EFFYo'] = _combine(s_low['EFFYo'], s_high['EFFYo'])
        states['Ja'] = _combine(s_low['Ja'], s_high['Ja'])

    states['EFFY'] = _combine(s_low['EFFY'], s_high['EFFY'])
    states['VMWV'] = _combine(s_low['VMWV'], s_high['VMWV'])

    return states


